<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.agentassert4j</groupId>
        <artifactId>agentassert4j-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>agentassert4j-sdk-langchain4j1</artifactId>
    <name>AgentAssert4j SDK - LangChain4j 1.x</name>

    <dependencies>
        <dependency>
            <groupId>io.github.agentassert4j</groupId>
            <artifactId>agentassert4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.agentassert4j</groupId>
            <artifactId>agentassert4j-recorder</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- LangChain4j 由接入方自带；本模块编译钉宣称支持的最老 GA（1.0.0），
             适配层只触碰地板已存在的符号，高版本二进制兼容 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>${langchain4j1.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
