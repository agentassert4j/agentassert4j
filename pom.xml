<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.agentassert4j</groupId>
    <artifactId>agentassert4j-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AgentAssert4j — AI Agent Behavior Assertion Testing Framework</name>
    <description>
        Zero-intrusion Java AI Agent behavior assertion testing tool.
        Assert Your Agent, Like You Assert Your Code.
    </description>
    <url>https://github.com/agentassert4j/agentassert4j</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>axy-yxa</id>
            <name>axy-yxa</name>
            <email>525238611@qq.com</email>
            <organization>agentassert4j</organization>
            <organizationUrl>https://github.com/agentassert4j</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/agentassert4j/agentassert4j.git</connection>
        <developerConnection>scm:git:git@github.com:agentassert4j/agentassert4j.git</developerConnection>
        <url>https://github.com/agentassert4j/agentassert4j</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <!-- 核心模块 -->
        <module>agentassert4j-core</module>
        <module>agentassert4j-recorder</module>
        <module>agentassert4j-cli</module>
        <module>agentassert4j-cli-standalone</module>

        <!-- 存储插件（聚合） -->
        <module>agentassert4j-storage</module>

        <!-- 框架适配 SDK（聚合） -->
        <module>agentassert4j-sdk</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <junit.version>5.10.3</junit.version>
        <disruptor.version>3.4.4</disruptor.version>
        <sqlite.version>3.46.0.0</sqlite.version>
        <picocli.version>4.7.6</picocli.version>
        <slf4j.version>2.0.13</slf4j.version>
        <!-- Spring AI 两代坐标同名互斥，不入 dependencyManagement，由 sdk 模块各自引用 -->
        <spring-ai1.version>1.0.0</spring-ai1.version>
        <spring-ai2.version>2.0.0</spring-ai2.version>
        <!-- LangChain4j 适配线：sdk 模块编译以最低支持版本为基线（宣称支持的最老 GA），starter 编译测试用最高验证版本 -->
        <langchain4j.version>1.0.0</langchain4j.version>
        <langchain4j-ceiling.version>1.18.0</langchain4j-ceiling.version>
        <!-- Boot 3.4 是 spring-ai 1.x 要求的最低线；3.4.0 的 spring-framework 6.2.0 与 spring-ai 1.0.0 传递的 6.2.6 混线（checkFlag 缺失），取线内对齐一致的最早 patch 3.4.5 -->
        <spring-boot3.version>3.4.5</spring-boot3.version>
        <!-- Boot 4.0 是 spring-ai 2.x 要求的最低线 -->
        <spring-boot4.version>4.0.0</spring-boot4.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-storage-sqlite</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-recorder</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-spring-ai1</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-langchain4j</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-spring-ai2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-starter-spring-ai1</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-cli</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party -->
            <dependency>
                <groupId>com.lmax</groupId>
                <artifactId>disruptor</artifactId>
                <version>${disruptor.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-nop</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>

            <!-- Test -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
            <!-- Maven Central 发布四件：sources / javadoc / GPG 签名 / Central 上传。
                 签名绑定 verify：口令经 settings.xml 的 gpg.passphrase server 段
                 （loopback 非交互），日常 install 会顺带签名，-Dgpg.skip 可关。
                 cli-standalone 不入 Central（随 GitHub Releases 分发），发布插件侧排除。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doclint>none</doclint>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.7</version>
                <configuration>
                    <keyname>C7C32A3405F0F8A3</keyname>
                    <passphraseServerId>gpg.passphrase</passphraseServerId>
                    <gpgArguments>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                    </gpgArguments>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.7.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!-- 首次发布走人工核对：上传后到 Portal 网页点 Publish，
                         校验结果逐条可见；稳定后再考虑 autoPublish -->
                    <autoPublish>false</autoPublish>
                    <excludeArtifacts>
                        <artifact>agentassert4j-cli-standalone</artifact>
                    </excludeArtifacts>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
