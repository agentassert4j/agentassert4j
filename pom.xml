<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.agentassert4j</groupId>
    <artifactId>agentassert4j-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AgentAssert4j — AI Agent Behavior Assertion Testing Framework</name>
    <description>
        Zero-intrusion Java AI Agent behavior assertion testing tool.
        Assert Your Agent, Like You Assert Your Code.
    </description>

    <modules>
        <!-- 核心模块 -->
        <module>agentassert4j-core</module>
        <module>agentassert4j-recorder</module>
        <module>agentassert4j-cli</module>

        <!-- 存储插件（聚合） -->
        <module>agentassert4j-storage</module>

        <!-- 框架适配 SDK（聚合） -->
        <module>agentassert4j-sdk</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <junit.version>5.10.3</junit.version>
        <disruptor.version>3.4.4</disruptor.version>
        <sqlite.version>3.46.0.0</sqlite.version>
        <picocli.version>4.7.6</picocli.version>
        <slf4j.version>2.0.13</slf4j.version>
        <!-- Spring AI 两代坐标同名互斥，不入 dependencyManagement，由 sdk 模块各自引用 -->
        <spring-ai1.version>1.0.0</spring-ai1.version>
        <spring-ai2.version>2.0.0</spring-ai2.version>
        <!-- Boot 3.4 是 spring-ai 1.x 要求的最低线；3.4.0 的 spring-framework 6.2.0 与 spring-ai 1.0.0 传递的 6.2.6 混线（checkFlag 缺失），取线内对齐一致的最早 patch 3.4.5 -->
        <spring-boot3.version>3.4.5</spring-boot3.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-storage-sqlite</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-recorder</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-sdk-spring-ai1</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-sdk-spring-ai2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-spring-boot3-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.agentassert4j</groupId>
                <artifactId>agentassert4j-cli</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party -->
            <dependency>
                <groupId>com.lmax</groupId>
                <artifactId>disruptor</artifactId>
                <version>${disruptor.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>

            <!-- Test -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
        </plugins>
    </build>
</project>
